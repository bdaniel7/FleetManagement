# Copy this file to .env and fill in your values before running docker-compose

# PostgreSQL password (used by both postgres service and API connection string)
POSTGRES_PASSWORD=fleet_change_me_in_production

# JWT signing secret — minimum 32 characters, randomly generated
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_SECRET_KEY

# Seq API key (optional, leave empty for development)
SEQ_API_KEY=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://seq:5341
