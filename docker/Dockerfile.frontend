# ── Build stage ───────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

COPY src/FleetManagement.Frontend/package*.json ./
RUN npm ci

COPY src/FleetManagement.Frontend/ .
RUN npm run build

# ── Serve via Nginx ───────────────────────────────────────────
FROM nginx:alpine AS runtime

COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s \
  CMD wget -qO- http://localhost/api/fleet/health || exit 1
