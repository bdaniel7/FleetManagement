<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FleetManagement.Core</AssemblyName>
    <RootNamespace>FleetManagement.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Graph.fs" />
    <Compile Include="Pathfinding.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Commands.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
  </ItemGroup>
</Project>
