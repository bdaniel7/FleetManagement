<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GraphTests.fs" />
    <Compile Include="PathfindingTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="ActorTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FleetManagement.Core\FleetManagement.Core.fsproj" />
    <ProjectReference Include="..\..\src\FleetManagement.Actors\FleetManagement.Actors.fsproj" />
    <ProjectReference Include="..\..\src\FleetManagement.Infrastructure\FleetManagement.Infrastructure.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Akka.TestKit"                 Version="1.5.*" />
    <PackageReference Include="Akka.TestKit.Xunit2"          Version="1.5.*" />
    <PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Update="FSharp.Core" Version="10.1.203" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.v3.core" Version="3.2.2" />
  </ItemGroup>
</Project>
